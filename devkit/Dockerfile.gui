# FEB devkit, gui tag: the devkit plus a desktop served as a web page, for rviz2, rqt and turtlesim
# on any OS without an X server on the laptop. About 1.5 GB more than the base image, which is why
# it is a separate tag. Build: docker build -f Dockerfile.gui -t ghcr.io/pranman1/feb-devkit:gui .
FROM ghcr.io/pranman1/feb-devkit:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-desktop \
        xvfb x11-utils x11-apps fluxbox hsetroot x11vnc novnc websockify \
        xfonts-base xterm \
    && rm -rf /var/lib/apt/lists/*

COPY entrypoint.sh /home/autodrive_devkit.sh
COPY desktop.sh /home/autodrive_devkit/desktop.sh
COPY rviz /home/autodrive_devkit/rviz
EXPOSE 6080
