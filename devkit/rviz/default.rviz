# rviz2 layout for the FEB devkit's web desktop: the cone racer's topics in the map frame.
# Opened by `feb-sim ros --gui`; harmless when nothing publishes (an empty grid).
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 500
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 60
      Color: 70; 70; 80
    - Class: rviz_default_plugins/PoseArray
      Name: Map (cones)
      Enabled: true
      Topic:
        Value: /feb/map
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Shape: Axes
      Axes Length: 0.15
      Axes Radius: 0.05
    - Class: rviz_default_plugins/Path
      Name: Raceline
      Enabled: true
      Topic:
        Value: /feb/raceline
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 60; 200; 120
      Line Width: 0.03
    - Class: rviz_default_plugins/Path
      Name: MPC plan
      Enabled: true
      Topic:
        Value: /feb/mpc_prediction
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 255; 80; 220
      Line Width: 0.05
    - Class: rviz_default_plugins/Pose
      Name: Car
      Enabled: true
      Topic:
        Value: /feb/pose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Shape: Arrow
      Shaft Length: 0.4
      Shaft Radius: 0.05
      Head Length: 0.15
      Head Radius: 0.1
      Color: 255; 210; 80
  Global Options:
    Background Color: 26; 22; 18
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top-down
      Scale: 25
      X: 10
      Y: 5
    Saved: ~
Window Geometry:
  X: 0
  Y: 0
  Width: 1040
  Height: 860
  Hide Left Dock: false
  Hide Right Dock: true
