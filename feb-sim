#!/usr/bin/env python3
"""feb-sim: one command to run the FEB simulator with your racing stack.

    ./feb-sim run                        bridge + simulator, drive with the keyboard
    ./feb-sim run --track loop --stack "ros2 launch feb_driver drive.launch.py"
    ./feb-sim run --stack "..." --opponent normal    race the house racer (slow | normal | fast | map)
    ./feb-sim practice --stack "..."      scored attempt (warm-up + 10 laps, 10 s per collision)
    ./feb-sim submit                     post the latest practice result to the leaderboard
    ./feb-sim shell                      a ROS 2 shell inside the running devkit container
    ./feb-sim stop                       stop the devkit container
    ./feb-sim setup                      check Docker and fetch the simulator app for this OS

The devkit (ROS 2 bridge + your packages) runs in Docker and publishes port 4567.
The simulator is a native app for your OS and connects to that port. Packages under
./stack are mounted into the container and built when it starts.

Environment overrides: FEB_SIM_APP (simulator executable), FEB_DEVKIT_IMAGE.
"""
import argparse
import json
import os
import pathlib
import platform
import shutil
import socket
import subprocess
import sys
import time

ROOT = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
from febrace import sim  # noqa: E402

TRACKS = ROOT / "tracks"
STACK = ROOT / "stack"
CONFIG = pathlib.Path.home() / ".feb-sim" / "config.json"
IMAGE = os.environ.get("FEB_DEVKIT_IMAGE", "ghcr.io/pranman1/feb-devkit:latest")
CONTAINER = "feb-devkit"
OPPONENT = "feb-opponent"
PROXY = "feb-proxy"
PORT = int(os.environ.get("FEB_DEVKIT_PORT", 4567))   # override when another bridge holds 4567 on this machine
OPPONENT_PORT = 4566
FOXGLOVE_PORT = 8765      # foxglove_bridge inside the devkit: live topics for the Foxglove app on the laptop
PROXY_PORT = 4565
OPPONENT_SPEED = {"slow": 1.5, "normal": 2.0, "fast": 2.5}   # the lidar house racer's max_speed
MAP_OPPONENT_SPEED = 2.5                                      # --opponent map: the map-following driver
RELEASES = "https://github.com/Pranman1/feb-racing/releases/latest/download"
RELEASES_API = "https://api.github.com/repos/Pranman1/feb-racing/releases/latest"


def fail(msg):
    sys.exit(f"feb-sim: {msg}")


# ------------------------------------------------------------------ simulator app

def app_executable():
    return sim.executable()


def cmd_setup(args):
    if args.team:
        CONFIG.parent.mkdir(parents=True, exist_ok=True)
        CONFIG.write_text(json.dumps({"team": args.team}))
        print(f"team set to '{args.team}'")
    if not shutil.which("docker"):
        fail("Docker is not installed. Install Docker Desktop (Mac/Windows) or docker.io (Linux) first.")
    subprocess.run(["docker", "pull", IMAGE], check=True)
    if app_executable():
        print(f"simulator app present: {app_executable()}")
    else:
        install_app()
    check_foxglove()


def cmd_update(_):
    """Bring everything up to date: the repo (tracks, launcher, docs), the devkit image, the app."""
    if (ROOT / ".git").exists():
        subprocess.run(["git", "-C", str(ROOT), "pull", "--ff-only"], check=False)
    subprocess.run(["docker", "pull", IMAGE], check=False)
    latest = latest_release_stamp()
    if latest is None:
        print("could not reach GitHub to check the app; kept the installed one")
    elif latest == installed_release_stamp():
        print(f"simulator app is current ({latest})")
    else:
        install_app(latest)


STAMP = sim.APP_DIR / "release.json"      # which release asset the installed app came from


def installed_release_stamp():
    try:
        return json.loads(STAMP.read_text())["updated_at"]
    except (OSError, ValueError, KeyError):
        return None


def latest_release_stamp(timeout=4):
    """The updated_at of this platform's archive in the latest release, or None offline."""
    import urllib.request
    try:
        with urllib.request.urlopen(RELEASES_API, timeout=timeout) as r:
            release = json.load(r)
        return next(a["updated_at"] for a in release["assets"] if a["name"] == sim.archive_name())
    except Exception:
        return None


def install_app(stamp=None):
    import tarfile
    import urllib.request
    import zipfile
    name = sim.archive_name()
    dest = sim.platform_dir()
    if dest.is_symlink():
        dest.unlink()        # the organiser PC links the app to the build folder; do not write through it
    elif dest.exists():
        shutil.rmtree(dest)  # replace the old install wholesale: builds add and remove files
    dest.mkdir(parents=True)
    archive = sim.APP_DIR / name
    print(f"downloading {RELEASES}/{name} ...")
    urllib.request.urlretrieve(f"{RELEASES}/{name}", archive)
    if name.endswith(".zip"):
        if shutil.which("unzip"):    # keeps permissions and symlinks inside the Mac app bundle
            subprocess.run(["unzip", "-q", str(archive), "-d", str(dest)], check=True)
        else:
            zipfile.ZipFile(archive).extractall(dest)
    else:
        tarfile.open(archive).extractall(dest)
    archive.unlink()
    exe = app_executable()
    if exe is None:
        fail(f"unpacked the app but did not find the executable under {sim.APP_DIR}")
    exe.chmod(0o755)
    STAMP.write_text(json.dumps({"updated_at": stamp or latest_release_stamp() or ""}))
    print(f"simulator app installed: {exe}")


def app_update_hint():
    """One line if a newer app is on the release page; silent offline (a 2 s budget)."""
    latest = latest_release_stamp(timeout=2)
    installed = installed_release_stamp()
    if latest and installed and latest != installed:
        print("a newer simulator app is available: ./feb-sim update")


def check_foxglove():
    """Foxglove is how members look at their car's data (lidar, camera, plots). It is a separate
    desktop app with its own installer per OS and a one-time sign-in, so setup only points at it."""
    if foxglove_app():
        print(f"Foxglove app present: {foxglove_app()}")
        return
    print("Foxglove app not found. Install it from https://foxglove.dev/download and sign in once")
    print("(free account); `feb-sim run` then opens it on your car's topics. Optional but recommended.")
    import webbrowser
    webbrowser.open("https://foxglove.dev/download")


# ------------------------------------------------------------------ devkit container

def container_running():
    out = subprocess.run(["docker", "ps", "-q", "-f", f"name=^{CONTAINER}$"], capture_output=True, text=True)
    return bool(out.stdout.strip())


def start_container(stack_cmd, noise=""):
    if container_running():
        subprocess.run(["docker", "rm", "-f", CONTAINER], capture_output=True)
    STACK.mkdir(exist_ok=True)
    cmd = ["docker", "run", "-d", "--rm", "--name", CONTAINER, "-p", f"{PORT}:4567",
           "-p", f"{FOXGLOVE_PORT}:{FOXGLOVE_PORT}", "-e", "ROS_LOCALHOST_ONLY=1",
           "-v", f"{STACK}:/home/autodrive_devkit/src/stack",
           "-v", f"{TRACKS}:/home/autodrive_devkit/tracks:ro",
           "-e", f"FEB_LAUNCH={stack_cmd or ''}", "-e", f"FEB_NOISE={noise}", IMAGE]
    subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL)
    deadline = time.time() + 120
    while time.time() < deadline:
        if not container_running():
            subprocess.run(["docker", "logs", CONTAINER])
            fail("devkit container exited, see log above")
        with socket.socket() as s:
            s.settimeout(0.5)
            if s.connect_ex(("127.0.0.1", PORT)) == 0:
                return
        time.sleep(1)
    fail("bridge did not open port 4567 within 120 s (docker logs feb-devkit)")


def start_opponent(level, track):
    """The house racer in its own container, plus the proxy that feeds car 2 to it. Default: the
    smooth lidar driver from the starter kit at a conservative pace (the thing to overtake);
    "map" runs the map-following driver instead."""
    subprocess.run(["docker", "rm", "-f", OPPONENT, PROXY], capture_output=True)
    if not json.loads((pathlib.Path(track) / "track.json").read_text()).get("walls"):
        level = "map"   # no walls to follow: the lidar racer would wander; the map follower knows the lane
    if level == "map":
        launch = f"ros2 run feb_tools house_driver --ros-args -p track:=/track -p max_speed:={MAP_OPPONENT_SPEED} -p use_sim_time:=true"
        speed = MAP_OPPONENT_SPEED
    else:
        speed = OPPONENT_SPEED[level]
        launch = f"ros2 run feb_driver reactive_driver --ros-args -p max_speed:={speed} -p bubble:=0.45 -p follow_gap:=2.0 -p use_sim_time:=true"
    subprocess.run(["docker", "run", "-d", "--rm", "--name", OPPONENT, "-p", f"{OPPONENT_PORT}:4567", "-e", "ROS_LOCALHOST_ONLY=1",
                    "-e", "FEB_FOXGLOVE=0",
                    "-v", f"{track}:/track:ro", "-v", f"{ROOT / 'starter_kit'}:/home/autodrive_devkit/src/stack:ro",
                    "-e", f"FEB_LAUNCH={launch}", IMAGE], check=True, stdout=subprocess.DEVNULL)
    proxy = ROOT / "febrace" / "proxy.py"
    subprocess.run(["docker", "run", "-d", "--rm", "--name", PROXY, "--network=host", "-v", f"{proxy}:/tmp/proxy.py:ro",
                    "--entrypoint", "python3", IMAGE, "-u", "/tmp/proxy.py", "--verbose", "--port", str(PROXY_PORT),
                    "--devkits", str(PORT), str(OPPONENT_PORT), "--rate", "10"], check=True, stdout=subprocess.DEVNULL)
    print(f"opponent: {'map-following' if level == 'map' else 'lidar'} house racer at {speed} m/s")


# ------------------------------------------------------------------ Foxglove

FOXGLOVE_URL = f"foxglove://open?ds=foxglove-websocket&ds.url=ws://localhost:{FOXGLOVE_PORT}"


def foxglove_app():
    """The Foxglove desktop app, if installed; the name changed from Foxglove Studio to Foxglove in 2024."""
    system = platform.system()
    if system == "Darwin":
        candidates = [pathlib.Path("/Applications") / n for n in ("Foxglove.app", "Foxglove Studio.app")]
    elif system == "Windows":
        base = pathlib.Path(os.environ.get("LOCALAPPDATA", "")) / "Programs"
        candidates = [base / "Foxglove" / "Foxglove.exe", base / "Foxglove Studio" / "Foxglove Studio.exe"]
    else:
        candidates = [pathlib.Path(p) for p in (shutil.which("foxglove"), shutil.which("foxglove-studio")) if p]
        candidates += [pathlib.Path(os.environ.get("FEB_FOXGLOVE_APP", "/nonexistent"))]
    return next((c for c in candidates if c.exists()), None)


def open_foxglove():
    """Open Foxglove on the running devkit (every topic, live). Prints the connection details if the
    app is not installed, so the member can connect by hand or use the web app."""
    app = foxglove_app()
    hint = f"Foxglove: Open connection -> Foxglove WebSocket -> ws://localhost:{FOXGLOVE_PORT}"
    if app is None:
        print(f"{hint}  (desktop app not found; install from https://foxglove.dev/download)")
        return
    system = platform.system()
    if system == "Darwin":
        cmd = ["open", "-a", str(app), FOXGLOVE_URL]
    elif system == "Windows":
        cmd = [str(app), FOXGLOVE_URL]
    else:
        cmd = [str(app), FOXGLOVE_URL]
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(f"opened {app.name} on ws://localhost:{FOXGLOVE_PORT}")


def cmd_stop(_):
    subprocess.run(["docker", "rm", "-f", CONTAINER, OPPONENT, PROXY], capture_output=True)
    print("devkit stopped")


def cmd_logs(args):
    """The devkit's log: the package build, the bridge and every line the stack prints."""
    if not container_running():
        fail("devkit is not running; start it with `feb-sim run`")
    os.execvp("docker", ["docker", "logs", "--tail", str(args.tail)] + (["-f"] if args.follow else []) + [CONTAINER])


def cmd_shell(_):
    if not container_running():
        fail("devkit is not running; start it with `feb-sim run`")
    os.execvp("docker", ["docker", "exec", "-it", CONTAINER, "bash", "-c",
                         "source /opt/ros/humble/setup.bash; source install/setup.bash; exec bash"])


# ------------------------------------------------------------------ run

def resolve_track(name):
    """A track folder in ./tracks, an explicit folder, or a name the app knows."""
    for candidate in (pathlib.Path(name), TRACKS / name):
        if (candidate / "track.json").exists():
            return str(candidate.resolve())
    return name


def cmd_run(args):
    exe = app_executable()
    if exe is None:
        fail("simulator app not found; run `feb-sim setup` or set FEB_SIM_APP")
    app_update_hint()
    print(f"starting devkit ({IMAGE}) ...")
    start_container(args.stack, args.noise)
    track = resolve_track(args.track)
    mode = args.mode or ("autonomous" if args.stack else "manual")
    cars, port = args.cars, PORT
    if args.opponent:
        if not args.stack:
            fail("--opponent races your stack, so it needs --stack \"ros2 launch ...\" as well")
        if not pathlib.Path(track).is_dir():
            fail("--opponent needs a track folder with track.json (a name from ./tracks or a path)")
        if json.loads((pathlib.Path(track) / "track.json").read_text()).get("max_cars", 4) < 2:
            fail(f"{pathlib.Path(track).name} is a single-car track (too narrow to race side by side)")
        start_opponent(args.opponent, track)
        cars, port = max(cars, 2), PROXY_PORT
    sim = [str(exe), "--track", track, "--tracks", str(TRACKS), "--connect", f"127.0.0.1:{port}",
           "--mode", mode, "--cars", str(cars)]
    if args.lidar_hz:
        sim += ["--lidar-hz", str(args.lidar_hz)]
    if args.camera:
        sim += ["--camera", args.camera]
    if args.look or args.headless:
        sim += ["--look", "simple" if args.headless else args.look]   # nothing to see headless
    if args.fps is not None:
        sim += ["--fps", str(args.fps)]
    if args.camera_hz is not None:
        sim += ["--camera-hz", str(args.camera_hz)]
    if args.headless:
        sim += ["-batchmode", "-nographics"]
    print("starting simulator:", " ".join(sim[1:]))
    try:
        proc = subprocess.Popen(sim)
        if not args.headless and not args.no_foxglove:
            time.sleep(4)          # let the window come up first, so Foxglove lands on top
            open_foxglove()
        proc.wait()
    finally:
        cmd_stop(args)


# ------------------------------------------------------------------ practice and submit

def team_name():
    try:
        return json.loads(CONFIG.read_text())["team"]
    except (OSError, KeyError, ValueError):
        fail("no team name yet; run `feb-sim setup --team \"Your Team\"` (as listed in submissions.yaml)")


def cmd_practice(args):
    """A scored attempt under competition rules, on your own machine."""
    from febrace import rules
    from febrace.runner import Attempt
    exe = app_executable()
    if exe is None:
        fail("simulator app not found; run `feb-sim setup` or set FEB_SIM_APP")
    if not args.stack:
        fail("practice needs your stack, e.g. --stack \"ros2 launch feb_driver drive.launch.py\"")
    cmd_stop(args)
    attempt = Attempt(image=IMAGE, track=resolve_track(args.track), sim_exe=exe, team=team_name(),
                      rules=rules.Rules(laps=args.laps), port=PORT, headless=args.headless,
                      stack_dir=STACK, stack_cmd=args.stack, runs_dir=ROOT / "runs")
    result = attempt.run()
    print(f"\n{result['status']}: laps {result['laps_completed']}, collisions {result['collisions']}, "
          f"total {result['total_s']} s, best lap {result['best_lap_s']} s")
    print(f"saved to {attempt.dir}. Post it with: ./feb-sim submit")


def cmd_submit(args):
    """Post the latest practice result to the leaderboard as a pull request (needs the gh CLI)."""
    from febrace import results
    if not shutil.which("gh"):
        fail("the GitHub CLI is required: https://cli.github.com (then `gh auth login`)")
    run_dir = pathlib.Path(args.run) if args.run else max((ROOT / "runs").glob("*/result.json"), key=os.path.getmtime).parent
    result = json.loads((run_dir / "result.json").read_text())
    path = results.save(result).relative_to(ROOT)
    branch = f"result/{result['id']}"
    git = lambda *a: subprocess.run(["git", "-C", str(ROOT), *a], check=True)
    git("checkout", "-B", branch)
    git("add", str(path))
    git("commit", "-m", f"Practice result: {result['team']} on {result['track']} ({result['status']}, total {result['total_s']} s)")
    if subprocess.run(["git", "-C", str(ROOT), "push", "-u", "origin", branch]).returncode != 0:
        subprocess.run(["gh", "repo", "fork", "--remote", "--remote-name", "fork"], cwd=ROOT, check=True)
        git("push", "-u", "fork", branch)
    subprocess.run(["gh", "pr", "create", "--fill", "--head", branch], cwd=ROOT, check=True)
    git("checkout", "-")
    print("pull request opened; it merges automatically once the checks pass")


def main():
    ap = argparse.ArgumentParser(prog="feb-sim", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="command", required=True)
    run = sub.add_parser("run", help="start devkit + simulator")
    run.add_argument("--track", default="loop", help="track folder name in ./tracks, or a path")
    run.add_argument("--mode", choices=["manual", "autonomous"], help="default: autonomous with --stack, manual without")
    run.add_argument("--stack", default="", help='command started after the bridge, e.g. "ros2 launch feb_driver drive.launch.py"')
    run.add_argument("--headless", action="store_true", help="no window (organiser harness)")
    run.add_argument("--lidar-hz", type=float, default=0, help="lidar scan rate override (default: the car's 40 Hz)")
    run.add_argument("--noise", default="", help='sensor noise, "1" for defaults or e.g. "range_sigma:=0.03 beam_dropout:=0.05 latency:=0.05"')
    run.add_argument("--cars", type=int, default=1, help="number of cars (head-to-head practice)")
    run.add_argument("--opponent", choices=list(OPPONENT_SPEED) + ["map"], help="house racer in car 2: slow | normal | fast (lidar driver) or map")
    run.add_argument("--camera", help="starting camera: \"God's Eye\", Trackcam, \"Driver's Eye\", ...")
    run.add_argument("--no-foxglove", action="store_true", help="do not open Foxglove on the devkit's topics")
    run.add_argument("--look", choices=["visual", "simple"], help="dressed scene or the bare one (default: last choice in the app, else visual)")
    run.add_argument("--fps", type=int, help="render-rate cap (default 60, 0 = uncapped); keeps simulated time at real time")
    run.add_argument("--camera-hz", type=float, help="bridge camera readback rate (default 10, 0 = every message)")
    run.set_defaults(func=cmd_run)
    practice = sub.add_parser("practice", help="scored attempt under competition rules")
    practice.add_argument("--track", default="loop")
    practice.add_argument("--stack", required=True, help='e.g. "ros2 launch feb_driver drive.launch.py"')
    practice.add_argument("--laps", type=int, default=10)
    practice.add_argument("--headless", action="store_true")
    practice.set_defaults(func=cmd_practice)
    submit = sub.add_parser("submit", help="post the latest practice result as a pull request")
    submit.add_argument("--run", help="a runs/<id> folder (default: newest)")
    submit.set_defaults(func=cmd_submit)
    setup = sub.add_parser("setup", help="install prerequisites, optionally set your team name")
    setup.add_argument("--team")
    sub.add_parser("update", help="git pull, newer devkit image, newer simulator app").set_defaults(func=cmd_update)
    setup.set_defaults(func=cmd_setup)
    for name, func in (("shell", cmd_shell), ("stop", cmd_stop)):
        sub.add_parser(name).set_defaults(func=func)
    logs = sub.add_parser("logs", help="the devkit's log (build, bridge, your stack); -f follows")
    logs.add_argument("-f", "--follow", action="store_true")
    logs.add_argument("-n", "--tail", default="200", help="lines to show (default 200, 'all')")
    logs.set_defaults(func=cmd_logs)
    args = ap.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
