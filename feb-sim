#!/usr/bin/env python3
"""feb-sim: one command to run the FEB simulator with your racing stack.

    ./feb-sim run                        bridge + simulator, drive with the keyboard
    ./feb-sim run --track loop --stack "ros2 launch feb_driver drive.launch.py"
    ./feb-sim run --stack "..." --opponent normal    race the stock driver (slow | normal | fast)
    ./feb-sim practice --stack "..."      scored attempt (warm-up + 10 laps, 10 s per collision)
    ./feb-sim submit                     post the latest practice result to the leaderboard
    ./feb-sim shell                      a ROS 2 shell inside the running devkit container
    ./feb-sim stop                       stop the devkit container
    ./feb-sim setup                      check Docker and fetch the simulator app for this OS

The devkit (ROS 2 bridge + your packages) runs in Docker and publishes port 4567.
The simulator is a native app for your OS and connects to that port. Packages under
./stack are mounted into the container and built when it starts.

Environment overrides: FEB_SIM_APP (simulator executable), FEB_DEVKIT_IMAGE.
"""
import argparse
import json
import os
import pathlib
import platform
import shutil
import socket
import subprocess
import sys
import time

ROOT = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
from febrace import sim  # noqa: E402

TRACKS = ROOT / "tracks"
STACK = ROOT / "stack"
CONFIG = pathlib.Path.home() / ".feb-sim" / "config.json"
IMAGE = os.environ.get("FEB_DEVKIT_IMAGE", "ghcr.io/pranman1/feb-devkit:latest")
CONTAINER = "feb-devkit"
OPPONENT = "feb-opponent"
PROXY = "feb-proxy"
PORT = 4567
OPPONENT_PORT = 4566
PROXY_PORT = 4565
OPPONENT_SPEED = {"slow": 1.5, "normal": 2.5, "fast": 4.0}
RELEASES = "https://github.com/Pranman1/feb-racing/releases/latest/download"


def fail(msg):
    sys.exit(f"feb-sim: {msg}")


# ------------------------------------------------------------------ simulator app

def app_executable():
    return sim.executable()


def cmd_setup(args):
    if args.team:
        CONFIG.parent.mkdir(parents=True, exist_ok=True)
        CONFIG.write_text(json.dumps({"team": args.team}))
        print(f"team set to '{args.team}'")
    if not shutil.which("docker"):
        fail("Docker is not installed. Install Docker Desktop (Mac/Windows) or docker.io (Linux) first.")
    subprocess.run(["docker", "pull", IMAGE], check=True)
    if app_executable():
        print(f"simulator app present: {app_executable()}")
        return
    import tarfile
    import urllib.request
    import zipfile
    name = sim.archive_name()
    sim.APP_DIR.mkdir(parents=True, exist_ok=True)
    archive = sim.APP_DIR / name
    print(f"downloading {RELEASES}/{name} ...")
    urllib.request.urlretrieve(f"{RELEASES}/{name}", archive)
    if name.endswith(".zip"):
        zipfile.ZipFile(archive).extractall(sim.APP_DIR)
    else:
        tarfile.open(archive).extractall(sim.APP_DIR)
    archive.unlink()
    exe = app_executable()
    if exe is None:
        fail(f"unpacked the app but did not find the executable under {sim.APP_DIR}")
    exe.chmod(0o755)
    print(f"simulator app installed: {exe}")


# ------------------------------------------------------------------ devkit container

def container_running():
    out = subprocess.run(["docker", "ps", "-q", "-f", f"name=^{CONTAINER}$"], capture_output=True, text=True)
    return bool(out.stdout.strip())


def start_container(stack_cmd, noise=""):
    if container_running():
        subprocess.run(["docker", "rm", "-f", CONTAINER], capture_output=True)
    STACK.mkdir(exist_ok=True)
    cmd = ["docker", "run", "-d", "--rm", "--name", CONTAINER, "-p", f"{PORT}:{PORT}", "-e", "ROS_LOCALHOST_ONLY=1",
           "-v", f"{STACK}:/home/autodrive_devkit/src/stack",
           "-v", f"{TRACKS}:/home/autodrive_devkit/tracks:ro",
           "-e", f"FEB_LAUNCH={stack_cmd or ''}", "-e", f"FEB_NOISE={noise}", IMAGE]
    subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL)
    deadline = time.time() + 120
    while time.time() < deadline:
        if not container_running():
            subprocess.run(["docker", "logs", CONTAINER])
            fail("devkit container exited, see log above")
        with socket.socket() as s:
            s.settimeout(0.5)
            if s.connect_ex(("127.0.0.1", PORT)) == 0:
                return
        time.sleep(1)
    fail("bridge did not open port 4567 within 120 s (docker logs feb-devkit)")


def start_opponent(level):
    """The stock starter driver in its own container, plus the proxy that feeds car 2 to it."""
    subprocess.run(["docker", "rm", "-f", OPPONENT, PROXY], capture_output=True)
    speed = OPPONENT_SPEED[level]
    launch = f"ros2 run feb_driver reactive_driver --ros-args -p max_speed:={speed}"
    subprocess.run(["docker", "run", "-d", "--rm", "--name", OPPONENT, "-p", f"{OPPONENT_PORT}:4567", "-e", "ROS_LOCALHOST_ONLY=1",
                    "-v", f"{ROOT / 'starter_kit'}:/home/autodrive_devkit/src/stack:ro", "-e", f"FEB_LAUNCH={launch}", IMAGE],
                   check=True, stdout=subprocess.DEVNULL)
    proxy = ROOT / "febrace" / "proxy.py"
    subprocess.run(["docker", "run", "-d", "--rm", "--name", PROXY, "--network=host", "-v", f"{proxy}:/tmp/proxy.py:ro",
                    "--entrypoint", "python3", IMAGE, "-u", "/tmp/proxy.py", "--port", str(PROXY_PORT),
                    "--devkits", str(PORT), str(OPPONENT_PORT)], check=True, stdout=subprocess.DEVNULL)
    print(f"opponent: stock driver at {speed} m/s")


def cmd_stop(_):
    subprocess.run(["docker", "rm", "-f", CONTAINER, OPPONENT, PROXY], capture_output=True)
    print("devkit stopped")


def cmd_shell(_):
    if not container_running():
        fail("devkit is not running; start it with `feb-sim run`")
    os.execvp("docker", ["docker", "exec", "-it", CONTAINER, "bash", "-c",
                         "source /opt/ros/humble/setup.bash; source install/setup.bash; exec bash"])


# ------------------------------------------------------------------ run

def resolve_track(name):
    """A track folder in ./tracks, an explicit folder, or a name the app knows."""
    for candidate in (pathlib.Path(name), TRACKS / name):
        if (candidate / "track.json").exists():
            return str(candidate.resolve())
    return name


def cmd_run(args):
    exe = app_executable()
    if exe is None:
        fail("simulator app not found; run `feb-sim setup` or set FEB_SIM_APP")
    print(f"starting devkit ({IMAGE}) ...")
    start_container(args.stack, args.noise)
    cars, port = args.cars, PORT
    if args.opponent:
        start_opponent(args.opponent)
        cars, port = max(cars, 2), PROXY_PORT
    sim = [str(exe), "--track", resolve_track(args.track), "--connect", f"127.0.0.1:{port}",
           "--mode", args.mode, "--cars", str(cars)]
    if args.lidar_hz:
        sim += ["--lidar-hz", str(args.lidar_hz)]
    if args.camera:
        sim += ["--camera", args.camera]
    if args.headless:
        sim += ["-batchmode", "-nographics"]
    print("starting simulator:", " ".join(sim[1:]))
    try:
        subprocess.run(sim)
    finally:
        cmd_stop(args)


# ------------------------------------------------------------------ practice and submit

def team_name():
    try:
        return json.loads(CONFIG.read_text())["team"]
    except (OSError, KeyError, ValueError):
        fail("no team name yet; run `feb-sim setup --team \"Your Team\"` (as listed in submissions.yaml)")


def cmd_practice(args):
    """A scored attempt under competition rules, on your own machine."""
    from febrace import rules
    from febrace.runner import Attempt
    exe = app_executable()
    if exe is None:
        fail("simulator app not found; run `feb-sim setup` or set FEB_SIM_APP")
    if not args.stack:
        fail("practice needs your stack, e.g. --stack \"ros2 launch feb_driver drive.launch.py\"")
    cmd_stop(args)
    attempt = Attempt(image=IMAGE, track=resolve_track(args.track), sim_exe=exe, team=team_name(),
                      rules=rules.Rules(laps=args.laps), port=PORT, headless=args.headless,
                      stack_dir=STACK, stack_cmd=args.stack, runs_dir=ROOT / "runs")
    result = attempt.run()
    print(f"\n{result['status']}: laps {result['laps_completed']}, collisions {result['collisions']}, "
          f"total {result['total_s']} s, best lap {result['best_lap_s']} s")
    print(f"saved to {attempt.dir}. Post it with: ./feb-sim submit")


def cmd_submit(args):
    """Post the latest practice result to the leaderboard as a pull request (needs the gh CLI)."""
    from febrace import results
    if not shutil.which("gh"):
        fail("the GitHub CLI is required: https://cli.github.com (then `gh auth login`)")
    run_dir = pathlib.Path(args.run) if args.run else max((ROOT / "runs").glob("*/result.json"), key=os.path.getmtime).parent
    result = json.loads((run_dir / "result.json").read_text())
    path = results.save(result).relative_to(ROOT)
    branch = f"result/{result['id']}"
    git = lambda *a: subprocess.run(["git", "-C", str(ROOT), *a], check=True)
    git("checkout", "-B", branch)
    git("add", str(path))
    git("commit", "-m", f"Practice result: {result['team']} on {result['track']} ({result['status']}, total {result['total_s']} s)")
    if subprocess.run(["git", "-C", str(ROOT), "push", "-u", "origin", branch]).returncode != 0:
        subprocess.run(["gh", "repo", "fork", "--remote", "--remote-name", "fork"], cwd=ROOT, check=True)
        git("push", "-u", "fork", branch)
    subprocess.run(["gh", "pr", "create", "--fill", "--head", branch], cwd=ROOT, check=True)
    git("checkout", "-")
    print("pull request opened; it merges automatically once the checks pass")


def main():
    ap = argparse.ArgumentParser(prog="feb-sim", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="command", required=True)
    run = sub.add_parser("run", help="start devkit + simulator")
    run.add_argument("--track", default="loop", help="track folder name in ./tracks, or a path")
    run.add_argument("--mode", choices=["manual", "autonomous"], default="manual")
    run.add_argument("--stack", default="", help='command started after the bridge, e.g. "ros2 launch feb_driver drive.launch.py"')
    run.add_argument("--headless", action="store_true", help="no window (organiser harness)")
    run.add_argument("--lidar-hz", type=float, default=0, help="lidar scan rate override (default: the car's 40 Hz)")
    run.add_argument("--noise", default="", help='sensor noise, "1" for defaults or e.g. "range_sigma:=0.03 beam_dropout:=0.05 latency:=0.05"')
    run.add_argument("--cars", type=int, default=1, help="number of cars (head-to-head practice)")
    run.add_argument("--opponent", choices=list(OPPONENT_SPEED), help="race the stock driver in car 2 at this pace")
    run.add_argument("--camera", help="starting camera: \"God's Eye\", Trackcam, \"Driver's Eye\", ...")
    run.set_defaults(func=cmd_run)
    practice = sub.add_parser("practice", help="scored attempt under competition rules")
    practice.add_argument("--track", default="loop")
    practice.add_argument("--stack", required=True, help='e.g. "ros2 launch feb_driver drive.launch.py"')
    practice.add_argument("--laps", type=int, default=10)
    practice.add_argument("--headless", action="store_true")
    practice.set_defaults(func=cmd_practice)
    submit = sub.add_parser("submit", help="post the latest practice result as a pull request")
    submit.add_argument("--run", help="a runs/<id> folder (default: newest)")
    submit.set_defaults(func=cmd_submit)
    setup = sub.add_parser("setup", help="install prerequisites, optionally set your team name")
    setup.add_argument("--team")
    setup.set_defaults(func=cmd_setup)
    for name, func in (("shell", cmd_shell), ("stop", cmd_stop)):
        sub.add_parser(name).set_defaults(func=func)
    args = ap.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
