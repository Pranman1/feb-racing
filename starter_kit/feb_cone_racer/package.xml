<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>feb_cone_racer</name>
  <version>0.1.0</version>
  <description>Cone-track racer: perception, GraphSLAM map, minimum-curvature raceline, nonlinear MPC (dynamic bicycle, CasADi).</description>
  <maintainer email="pranavbhatttheonlyone@gmail.com">FEB Autonomous</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <test_depend>ament_copyright</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
