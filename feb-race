#!/usr/bin/env python3
"""feb-race: the organiser's competition runner (Linux PC with the headless simulator).

    ./feb-race run --image IMG --team NAME --track tracks/loop      one attempt, prints the score
    ./feb-race event 2026-10-qualification                          run every entry of an event
    ./feb-race nightly                                              rerun all teams on all practice tracks
    ./feb-race verify results/practice/loop/Team-....json           rerun a self-reported result
    ./feb-race standings 2026-10-qualification                      print an event's table
    ./feb-race h2h --teams "Team A" "Team B" --track tracks/loop      one head-to-head race
    ./feb-race bracket 2026-11-final --seed-from 2026-10-qualification  knockout tournament
    ./feb-race site                                                 build the leaderboard site

Results land in results/ (commit and push them; GitHub Pages renders the leaderboard).
Secret competition tracks live outside the repo (see events/*.yaml) and are never shipped.
"""
import argparse
import json
import pathlib
import sys

import yaml

ROOT = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
from febrace import results, rules as rules_mod, sim  # noqa: E402
from febrace.runner import Attempt  # noqa: E402


def sim_exe():
    exe = sim.executable()
    if exe is None:
        sys.exit("feb-race: simulator app not found; build it (feb-sim/build.sh linux) or set FEB_SIM_APP")
    return exe


def track_path(name):
    p = pathlib.Path(name).expanduser()
    if (p / "track.json").exists():
        return p
    if (ROOT / "tracks" / name / "track.json").exists():
        return ROOT / "tracks" / name
    sys.exit(f"feb-race: no track at {name}")


def teams():
    return yaml.safe_load((ROOT / "submissions.yaml").read_text())["teams"]


def attempt(image, team, track, event, rules, gui=False, port=4568):
    a = Attempt(image=image, track=track, sim_exe=sim_exe(), team=team, event=event, rules=rules,
                port=port, headless=not gui, runs_dir=ROOT / "runs")
    print(f"== {team}  {image}  track={track.name}  event={event}")
    result = a.run()
    path = results.save(result)
    print(f"   {result['status']}  laps={result['laps_completed']}  collisions={result['collisions']}  "
          f"total={result['total_s']}  best={result['best_lap_s']}  -> {path.relative_to(ROOT)}")
    return result


def cmd_run(args):
    rules = rules_mod.Rules(laps=args.laps, timeout_s=args.timeout)
    attempt(args.image, args.team, track_path(args.track), args.event, rules, args.gui, args.port)


def cmd_event(args):
    spec = yaml.safe_load((ROOT / "events" / f"{args.event}.yaml").read_text())
    rules = rules_mod.Rules(**spec.get("rules", {}))
    track = track_path(spec["track"])
    entries = teams() if spec.get("entries", "all") == "all" else [t for t in teams() if t["name"] in spec["entries"]]
    for team in entries:
        for _ in range(int(spec.get("attempts", 1))):
            attempt(team["image"], team["name"], track, spec["id"], rules, args.gui)
    cmd_standings(args)


def cmd_nightly(args):
    tracks = [p.parent for p in sorted((ROOT / "tracks").glob("*/track.json"))]
    for team in teams():
        for track in tracks:
            attempt(team["image"], team["name"], track, "practice", rules_mod.Rules(), args.gui)


def cmd_verify(args):
    original = json.loads(pathlib.Path(args.result).read_text())
    result = attempt(original["image"], original["team"], track_path(original["track"]), "practice", rules_mod.Rules(**original["rules"]), args.gui)
    result["verified"] = True
    result["verifies"] = original["id"]
    results.save(result)


def cmd_standings(args):
    rows = [r for r in results.load_all() if r["event"] == args.event]
    best = {}
    for r in sorted(rows, key=rules_mod.rank_key):
        best.setdefault(r["team"], r)
    print(f"\n{'#':>2}  {'team':24} {'status':9} {'total':>8} {'best lap':>9} {'coll':>4}")
    for i, r in enumerate(best.values(), 1):
        print(f"{i:>2}  {r['team']:24} {r['status']:9} {str(r['total_s']):>8} {str(r['best_lap_s']):>9} {r['collisions']:>4}")


def race(spec_teams, track, event, race_id, rules, gui):
    from febrace.h2h import Race
    entries = [(t["name"], t["image"]) for t in spec_teams]
    print(f"== race {race_id}: " + " vs ".join(n for n, _ in entries))
    rows = Race(entries, track, sim_exe(), event, race_id, rules, headless=not gui, runs_dir=ROOT / "runs").run()
    for r in rows:
        results.save(r)
        print(f"   P{r['position']} {r['team']:24} laps={r['laps_completed']} finish={r['finish_s']} collisions={r['collisions']}")
    return rows


def cmd_h2h(args):
    by_name = {t["name"]: t for t in teams()}
    missing = [n for n in args.teams if n not in by_name]
    if missing:
        sys.exit(f"feb-race: unknown team(s) {missing}; add them to submissions.yaml")
    race([by_name[n] for n in args.teams], track_path(args.track), args.event, args.race, rules_mod.Rules(laps=args.laps), args.gui)


def cmd_bracket(args):
    from febrace.h2h import bracket
    spec = yaml.safe_load((ROOT / "events" / f"{args.event}.yaml").read_text())
    rules = rules_mod.Rules(**spec.get("rules", {}))
    track = track_path(spec["track"])
    by_name = {t["name"]: t for t in teams()}
    seeded = [r["team"] for r in sorted((r for r in results.load_all() if r["event"] == args.seed_from), key=rules_mod.rank_key)]
    seeded = list(dict.fromkeys(t for t in seeded if t in by_name))
    if len(seeded) < 2:
        sys.exit(f"feb-race: need at least two seeded teams from {args.seed_from}")
    round_no = 1
    while len(seeded) > 1:
        pairs, byes = bracket(seeded)
        winners = list(byes)
        for match, (a, b) in enumerate(pairs, 1):
            rows = race([by_name[a], by_name[b]], track, spec["id"], f"r{round_no}-m{match}", rules, args.gui)
            winners.append(rows[0]["team"])
        seeded, round_no = winners, round_no + 1
    print(f"\nwinner: {seeded[0]}")


def cmd_site(args):
    from febrace import site
    print("site built at", site.build())


def main():
    ap = argparse.ArgumentParser(prog="feb-race", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="command", required=True)

    run = sub.add_parser("run")
    run.add_argument("--image", required=True)
    run.add_argument("--team", required=True)
    run.add_argument("--track", required=True)
    run.add_argument("--event", default="practice")
    run.add_argument("--laps", type=int, default=10)
    run.add_argument("--timeout", type=float, default=300)
    run.add_argument("--port", type=int, default=4568)
    run.set_defaults(func=cmd_run)

    h2h = sub.add_parser("h2h")
    h2h.add_argument("--teams", nargs="+", required=True)
    h2h.add_argument("--track", required=True)
    h2h.add_argument("--event", default="practice")
    h2h.add_argument("--race", default="race")
    h2h.add_argument("--laps", type=int, default=10)
    h2h.set_defaults(func=cmd_h2h)
    br = sub.add_parser("bracket")
    br.add_argument("event")
    br.add_argument("--seed-from", required=True, help="time-attack event whose standings seed the bracket")
    br.set_defaults(func=cmd_bracket)

    for name, func, extra in (("event", cmd_event, "event"), ("standings", cmd_standings, "event"),
                              ("verify", cmd_verify, "result"), ("nightly", cmd_nightly, None), ("site", cmd_site, None)):
        p = sub.add_parser(name)
        if extra:
            p.add_argument(extra)
        p.set_defaults(func=func)
    for p in sub.choices.values():
        p.add_argument("--gui", action="store_true", help="show the simulator window")

    args = ap.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
